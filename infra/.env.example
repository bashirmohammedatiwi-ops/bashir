# Copy to .env and fill values before deploy
DOMAIN=deemaalhayat.com
CERTBOT_EMAIL=admin@deemaalhayat.com

POSTGRES_USER=alhayaa
POSTGRES_PASSWORD=change_me_strong_postgres_password
POSTGRES_DB=alhayaa

JWT_ACCESS_SECRET=change_me_long_random_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_long_random_refresh_secret_min_32_chars

ADMIN_EMAIL=admin@alhayaa.com
ADMIN_PASSWORD=ChangeMeStrongAdminPassword

CORS_ORIGIN=http://deemaalhayat.com,https://deemaalhayat.com,http://187.127.88.146

# Set to 1 only after HTTPS (port 443) is working — otherwise browsers may block HTTP access
ENABLE_HSTS=0

# Media URL — public HTTPS domain
MEDIA_PUBLIC_BASE_URL=https://deemaalhayat.com/media

# 1 = أنشئ/حدّث حساب الأدمن فقط عند إقلاع الـ API (بدون براندات/منتجات تجريبية)
# اتركه 0 بعد أول نشر — أو استخدم: ./scripts/reset-admin.sh
RUN_SEED=0

# لا تفعّل على الإنتاج — يضيف براندات/منتجات/عملاء تجريبيين (MAC, Dior…)
SEED_DEMO=0

# Media compression (stored on VPS before serving via Nginx)
MEDIA_MAX_FILE_SIZE_MB=15
MEDIA_MAX_ORIGINAL_WIDTH=2400
MEDIA_WEBP_QUALITY=90
MEDIA_JPEG_QUALITY=90
MEDIA_AVIF_QUALITY=62

THROTTLE_LIMIT=300

HOME_FEED_CACHE_TTL_SEC=90
# SENTRY_DSN=
DISK_WARN_PERCENT=85

# ── ترجمة المحتوى العربي → إنجليزي (CMS) ─────────────────
# DeepL موصى به للدقة (خطة مجانية: https://www.deepl.com/pro-api)
# DEEPL_API_KEY=your-deepl-key:fx
# GOOGLE_TRANSLATE_API_KEY=your-google-cloud-key

# ── تعبئة منتجات ذكية (تطبيق الموظفين) ───────────────────
# المفتاح يبقى على السيرفر فقط — لا يُوضع داخل APK
# OPENAI_API_KEY=sk-...
# أرخص موديل متاح عبر OpenAI API (بديل Cursor luna-low)
OPENAI_MODEL=gpt-5.4-nano
# بحث صور بالباركود عبر Google CSE (اختياري) — بدونها يُستخدم DuckDuckGo بالباركود مجاناً
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=

# ── Amazon Beauty ───────────────────────────────────────────
# اختياري — بدون مفاتيح يعمل الجلب عبر صفحات Amazon.
# مع مفاتيح PA-API أكثر استقراراً (Associates Central).
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_PARTNER_TAG=
# AMAZON_AUTO_CRAWL=0

# AI Shopping Assistant (customer-facing) — uses OPENAI_API_KEY above.
AI_ASSISTANT_ENABLED=1
AI_PRIMARY_MODEL=gpt-5.6-terra
AI_FAST_MODEL=gpt-5.4-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOOL_ITERATIONS=4
AI_REQUEST_TIMEOUT_MS=45000
AI_ASSISTANT_THROTTLE_PER_MIN=15
AI_DAILY_USER_MESSAGE_CAP=120
AI_DEBUG=0

# ── مزامنة الكتالوج إلى قمر الزمان (Al Hayaa → Qamar webhook) ──
# QAMAR_SYNC_WEBHOOK_URL=http://187.127.88.146:4320/api/v1/sync/alhayaa/webhook
# QAMAR_SYNC_WEBHOOK_SECRET=change_me_shared_sync_secret
# QAMAR_SYNC_WEBHOOK_TIMEOUT_MS=15000
