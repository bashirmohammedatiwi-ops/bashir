# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
# Or restrict: http://localhost:3001,http://localhost:5173,http://localhost:8080

# Database (PostgreSQL — use Docker: infra/docker-compose.yml)
# أضف connection_limit & pool_timeout حسب حجم النشر (الافتراضي physical CPUs*2+1).
# مع pgbouncer: استخدم &connection_limit=10 أو أقل.
DATABASE_URL=postgresql://alhayaa:alhayaa@localhost:5432/alhayaa?schema=public

# Redis (set REDIS_DISABLED=1 for local dev without Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_DISABLED=1

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_long_random
JWT_REFRESH_SECRET=change_me_refresh_secret_long_random
JWT_ACCESS_TTL=28800
JWT_REFRESH_TTL=2592000

# Media — compressed before storage (WebP + JPEG on disk)
MEDIA_ROOT=./uploads
MEDIA_PUBLIC_PREFIX=/media
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media
MEDIA_MAX_FILE_SIZE_MB=15
MEDIA_MAX_ORIGINAL_WIDTH=2400
MEDIA_WEBP_QUALITY=90
MEDIA_JPEG_QUALITY=90
MEDIA_AVIF_QUALITY=62

# Rate limiting (requests per minute per IP)
THROTTLE_LIMIT=200

# Home feed Redis cache (seconds)
HOME_FEED_CACHE_TTL_SEC=90

# Auto-translation Arabic → English for CMS content (optional — improves accuracy)
# Prefer DeepL for beauty/cosmetics phrasing; Google is a solid fallback.
# DEEPL_API_KEY=your-deepl-key
# GOOGLE_TRANSLATE_API_KEY=your-google-cloud-key

# Sentry error monitoring (optional — leave empty to disable)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Disk usage warning threshold for /health/ready (%)
DISK_WARN_PERCENT=85

# Firebase Cloud Messaging (optional — in-app notifications work without this)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
ADMIN_EMAIL=admin@alhayaa.com
ADMIN_PASSWORD=Admin@12345

# OpenAI — optional (catalog import scripts only). Keep on the server, never in the APK.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-nano
OPENAI_MODEL=gpt-5.4-nano

# Cursor API — admin-mobile add: Composer 2.5 Low verifies bilingual names only.
# CURSOR_API_KEY=crsr_...
# CURSOR_MODEL=composer-2.5
# composer-2.5-low = standard/cheap (fast=false). composer-2.5-fast = higher cost.
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=

# AI Shopping Assistant (customer-facing) — OpenAI powered.
# The assistant degrades to lexical-only templates when the key is absent.
AI_ASSISTANT_ENABLED=1
# Flagship model — discovery/comparison/routine recommendations only.
AI_PRIMARY_MODEL=gpt-5.6-terra
# Cheap strong model — simple intents (price/order/loyalty/casual) run on it
# end-to-end via cost routing; roughly 3x cheaper than the flagship tier.
AI_LIGHT_MODEL=gpt-5.4-mini
AI_FAST_MODEL=gpt-5.4-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOOL_ITERATIONS=4
AI_REQUEST_TIMEOUT_MS=45000
AI_RETRIEVAL_LIMIT=24
AI_ASSISTANT_THROTTLE_PER_MIN=15
AI_DAILY_USER_MESSAGE_CAP=120
AI_DEBUG=0
# طبقة الكاش الداخلية (بديل مجاني عند غياب Redis) — سقف عدد المفاتيح.
CACHE_MEMORY_MAX_KEYS=500
# AI_BASE_URL=https://api.openai.com/v1
